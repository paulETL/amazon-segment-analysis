import requests
from bs4 import BeautifulSoup
import pandas as pd

headers = {
    "User-Agent": "Mozilla/5.0"
}

filings = {
    2023: "https://www.sec.gov/Archives/edgar/data/1018724/000101872424000008/amzn-20231231.htm",
    2022: "https://www.sec.gov/Archives/edgar/data/1018724/000101872423000004/amzn-20221231.htm"
}

segments = ["North America", "International", "AWS"]


def clean_number(x):
    x = x.replace(",", "").replace("$", "").strip()
    
    if "(" in x and ")" in x:
        x = "-" + x.replace("(", "").replace(")", "")
    
    try:
        return float(x)
    except:
        return None


def extract_segment_table(soup):
    tables = soup.find_all("table")
    
    for table in tables:
        text = table.get_text(" ").lower()
        
        if all(seg.lower() in text for seg in ["north america", "international", "aws"]):
            return table
    
    return None


def parse_table(table):
    rows = table.find_all("tr")
    data = []
    
    for row in rows:
        cols = [c.get_text(strip=True) for c in row.find_all(["td", "th"])]
        if cols:
            data.append(cols)
    
    return data


def extract_values(table_data, year):
    results = []
    
    for row in table_data:
        row_text = " ".join(row).lower()
        
        for seg in segments:
            if seg.lower() in row_text:
                
                numbers = [clean_number(x) for x in row if isinstance(x, str)]
                numbers = [n for n in numbers if n is not None]
                
                if len(numbers) >= 2:
                    results.append({
                        "year": year,
                        "segment": seg,
                        "value_1": numbers[0],
                        "value_2": numbers[1]
                    })
    
    return results


all_data = []

for year, url in filings.items():
    print(f"Processing {year}...")
    
    res = requests.get(url, headers=headers)
    soup = BeautifulSoup(res.content, "lxml")
    
    table = extract_segment_table(soup)
    
    if table is None:
        print(f"Segment table not found for {year}")
        continue
    
    table_data = parse_table(table)
    
    extracted = extract_values(table_data, year)
    
    all_data.extend(extracted)


df = pd.DataFrame(all_data)

print(df)

df.to_csv("data/interim/extracted_tables/segment_raw_extracted.csv", index=False)